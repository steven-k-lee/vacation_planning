      <IconStyle>
        <scale>1.2</scale>
        <Icon>
          <href>https://mt.google.com/vt/icon/name=icons/onion/SHARED-mymaps-container-bg_4x.png,icons/onion/SHARED-mymaps-container_4x.png,icons/onion/1577-food-fork-knife_4x.png&amp;highlight=ff000000,F57C00,ff000000&amp;scale=1.0</href>
